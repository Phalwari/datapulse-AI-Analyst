# ==========================================
# DataPulse AI Analyst - Environment Configuration
# ==========================================

# ------------------------------------------
# LLM Provider Configuration
# ------------------------------------------
# Groq API (Primary LLM Provider)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.1-8b-instant"

# OpenRouter API (Alternative / Fallback LLM Provider)
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL="openrouter/free"

# ------------------------------------------
# Dataset Search & Storage Configuration
# ------------------------------------------
# Comma-separated directory paths to search for CSV datasets
# (Replaces hardcoded local user paths)
DATA_SEARCH_PATHS=""

# ------------------------------------------
# Server Configuration (Optional)
# ------------------------------------------
# Backend server port (Default: 8000)
# PORT=8000

